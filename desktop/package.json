{
  "name": "@omnibase/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "OmniBase personal desktop shell and local runtime supervisor.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package:windows": "node scripts/package-windows.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "20.17.10",
    "electron": "43.4.0",
    "tsx": "4.23.1",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.12.3"
}
