# ============================================================
# OmniBase 环境变量配置
# ============================================================
# 用法：cp .env.example .env，然后修改下方值
#
# 标记说明：
#   [必填]   不填则服务无法启动（compose 会报错）
#   [可选]   有默认值，按需修改
#   [生产]   部署到公网前必须修改默认值
# ============================================================

# ------------------------------------------------------------
# 数据库 (PostgreSQL + pgvector)
# ------------------------------------------------------------
POSTGRES_USER=omnibase                                    # [可选] 数据库用户名
POSTGRES_PASSWORD=changeme_strong_password_here           # [必填][生产] 数据库密码，请改成强密码
POSTGRES_DB=omnibase                                      # [可选] 数据库名
POSTGRES_PORT=5432                                        # [可选] 宿主机暴露端口（开发调试用）

# ------------------------------------------------------------
# 对象存储 (MinIO)
# ------------------------------------------------------------
MINIO_ROOT_USER=omnibase                                  # [可选] MinIO 管理员用户名
MINIO_ROOT_PASSWORD=changeme_strong_password_here         # [必填][生产] MinIO 管理员密码，至少 8 位
MINIO_BUCKET=omnibase-files                               # [可选] 文件存储 bucket 名（首次启动自动创建）
MINIO_API_PORT=9000                                       # [可选] S3 API 端口
MINIO_CONSOLE_PORT=9001                                   # [可选] Web 控制台端口

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
# [可选] Redis 密码，开发环境可留空。空值必须单独成行，避免 dotenv 将注释解析为密码。
REDIS_PASSWORD=
REDIS_PORT=6379                                           # [可选] 宿主机暴露端口

# ------------------------------------------------------------
# JWT 认证
# ------------------------------------------------------------
# [必填] JWT 签名密钥。生成方式（任选其一）：
#   Linux/Mac:  openssl rand -hex 32
#   Python:     python -c "import secrets; print(secrets.token_hex(32))"
#   PowerShell: -join ((48..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
#
# 警告：生产环境更换密钥会使所有已登录用户登出。
JWT_SECRET=please_generate_a_64_char_random_string_here
JWT_ALGORITHM=HS256                                       # [可选] JWT 签名算法
ACCESS_TOKEN_EXPIRE_MINUTES=30                            # [可选] Access token 有效期（分钟）
REFRESH_TOKEN_EXPIRE_DAYS=7                               # [可选] Refresh token 有效期（天）

# ------------------------------------------------------------
# 应用
# ------------------------------------------------------------
ENV=development                                          # [可选] development / production
LOG_LEVEL=INFO                                           # [可选] DEBUG / INFO / WARNING / ERROR
CORS_ORIGINS=["http://localhost:3000"]                   # [可选] JSON 数组格式；多个来源写入同一数组
MAX_UPLOAD_SIZE_MB=50                                    # [可选] 单文件上传上限（MB）
REQUEST_BODY_OVERHEAD_KB=1024                            # [可选] multipart 包装层额外空间（KiB）
RATE_LIMIT_ENABLED=true                                  # [可选] Redis 固定窗口限流总开关
RATE_LIMIT_FAIL_CLOSED=true                              # [推荐] Redis 故障时拒绝受保护请求；仅本地开发可显式设 false
RATE_LIMIT_WINDOW_SECONDS=60                             # [可选] 限流窗口（秒）
AUTH_RATE_LIMIT_PER_WINDOW=5                             # [可选] 登录/注册/刷新每来源窗口上限
RAG_RATE_LIMIT_PER_WINDOW=10                             # [可选] RAG 每租户用户窗口上限
UPLOAD_RATE_LIMIT_PER_WINDOW=10                          # [可选] 上传每租户用户窗口上限
REDIS_TIMEOUT_SECONDS=1.0                                # [可选] 限流 Redis 连接/命令超时（秒）
MODEL_CACHE_DIR=/app/models                              # [可选] 容器内模型缓存根目录
MODEL_DOWNLOAD_ENABLED=false                             # [可选] 默认禁止运行时隐式访问模型仓库
RERANKER_MODEL_PATH=/app/models/bge-reranker-v2-m3      # [可选] 本地 reranker 目录；缺失时快速降级到 RRF

# ------------------------------------------------------------
# 受保护的运维接口（仅后端/运维端）
# ------------------------------------------------------------
TENANT_MANAGEMENT_API_ENABLED=false                      # [可选] 默认关闭跨租户管理 API
# 启用上项时必填，至少 32 字符；禁止写入任何 NEXT_PUBLIC_* 变量。
PLATFORM_ADMIN_TOKEN=
# 原始 SQL HTTP API 已移除；数据库页面仅提供后端 allowlist 的元数据浏览。

# ------------------------------------------------------------
# LLM Provider（OpenAI-compatible）
# ------------------------------------------------------------
# [可选] 留空时知识检索仍可用，但 /api/rag/ask 会返回明确的 SSE 配置错误。
# 真实 Key 只写入已被 gitignore 的 .env，禁止提交到 Git、日志或验收证据。
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepseek.com/v1             # [可选] 也可使用其他 OpenAI-compatible 地址
LLM_MODEL=deepseek-chat                                  # [可选] 与所选 Provider 匹配的模型名

# ------------------------------------------------------------
# Embedding / Index migration（Phase 1.6）
# ------------------------------------------------------------
EMBEDDING_INDEX_VERSION=v1                               # [可选] 主写入通道；v1 保持现有 512d 行为
# [可选] 影子写入通道；安全默认关闭，可设 v2。留空时不要在等号后追加行内注释。
EMBEDDING_SHADOW_INDEX_VERSION=

# ------------------------------------------------------------
# 前端（开发 Compose）
# ------------------------------------------------------------
FRONTEND_PORT=3000                                        # [可选] 开发前端 loopback 端口

# 独立生产 benchmark Compose（不读取业务 secret）
FRONTEND_PROD_PORT=0                                      # [可选] 0 表示由 Docker 随机分配 loopback 端口
FRONTEND_PROD_API_PROXY_URL=http://host.docker.internal:8000  # [可选] 服务端 /api 代理目标

# ------------------------------------------------------------
# 后端
# ------------------------------------------------------------
BACKEND_PORT=8000                                         # [可选] 后端端口

# ------------------------------------------------------------
# Phase 5 (P5.0 admission gate — 保持关闭)
# ------------------------------------------------------------
# P5.0 只验证 Phase 5 是否允许开始，不运行任何 Agent/Planner/Executor。
# 三个 Feature Gate 独立解析、默认关闭：缺失/空值等于 false；只有精确
# "true"/"false" 被接受，未知值（大小写、空格、非标准字符串）配置错误；
# Planner 依赖 Runtime，Multi-Agent 依赖 Planner+Runtime。P34.7 未 ready
# 时即使全部为 true，P5.0 仍然 blocked。生产环境不得打开。
AGENT_RUNTIME_ENABLED=false                              # [生产] 必须保持 false
AGENT_PLANNER_ENABLED=false                              # [生产] 必须保持 false
MULTI_AGENT_ENABLED=false                                # [生产] 必须保持 false
