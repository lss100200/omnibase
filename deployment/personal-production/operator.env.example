# Copy this file to an operator-controlled path outside the source checkout.
# Every REPLACE_WITH_* value is a non-secret rendering placeholder and MUST be
# replaced before a container is started. Never commit the populated file.

OMNIBASE_FRONTEND_PORT=3000

POSTGRES_USER=omnibase
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=omnibase
DATABASE_URL=postgresql+psycopg://omnibase:REPLACE_WITH_URLENCODED_POSTGRES_PASSWORD@postgres:5432/omnibase

MINIO_ROOT_USER=omnibase
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_ROOT_PASSWORD
MINIO_BUCKET=omnibase-files

REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URLENCODED_REDIS_PASSWORD@redis:6379/0

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_000000
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64URL_32_BYTE_KEY
MEMORY_CONTENT_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_BASE64URL_32_BYTE_KEY
PROVIDER_ENDPOINT_ALLOWLIST=["api.deepseek.com","open.bigmodel.cn","dashscope.aliyuncs.com","api.openai.com"]
OMNIBASE_DEPLOYMENT_INSTANCE_ID=REPLACE_WITH_RANDOM_UUID_V4
CORS_ORIGINS=["http://127.0.0.1:3000"]
