# Shape-only example. The disposable Gate wrapper generates random synthetic
# values in a git-ignored temporary file and passes it with --env-file.
TEST_DATABASE_NAME=omnibase_test_p345d_gateway
TEST_DATABASE_ROLE=omnibase_test_p345d_runner
TEST_DATABASE_OWNER_PASSWORD=replace-with-disposable-random-value
TEST_DATABASE_PASSWORD=replace-with-disposable-random-value
GATE_GATEWAY_IMAGE=sha256:replace-with-the-clean-checkout-gateway-gate-image-id
GATE_POSTGRES_IMAGE=sha256:replace-with-an-existing-verified-postgres-image-id
GATE_CLIENT_IMAGE=sha256:replace-with-the-clean-checkout-minimal-client-image-id
