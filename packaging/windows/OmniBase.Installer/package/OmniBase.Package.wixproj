<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PythonExecutable Condition="'$(PythonExecutable)' == ''">python</PythonExecutable>
    <OutputName>OmniBase-$(ProductVersion)-windows-x64</OutputName>
    <GeneratedPayloadWxs>$(IntermediateOutputPath)OmniBase.Payload.g.wxs</GeneratedPayloadWxs>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(PayloadRoot)' != ''">
    <BindPath Include="$(PayloadRoot)" BindName="PayloadRoot" />
  </ItemGroup>

  <Target Name="ValidateOmniBasePayload" BeforeTargets="Compile">
    <Error
      Condition="'$(PayloadRoot)' == ''"
      Text="PayloadRoot must be an absolute path to an already-built OmniBase desktop payload."
    />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec
      Command="&quot;$(PythonExecutable)&quot; &quot;$(MSBuildThisFileDirectory)..\tools\validate_payload.py&quot; --payload-root &quot;$(PayloadRoot)&quot; --output-wxs &quot;$(GeneratedPayloadWxs)&quot;"
    />
    <ItemGroup>
      <Compile Include="$(GeneratedPayloadWxs)" />
    </ItemGroup>
  </Target>
</Project>
